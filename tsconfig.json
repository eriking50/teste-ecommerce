
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src/",
    "moduleResolution": "node",
    "baseUrl": ".",
        "paths": {
      "src/*": ["src/*"]
    },
    "outDir": "dist",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
        "strictPropertyInitialization": false,
    "strict": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src"],
  "ts-node": { "transpileOnly": true }
}